# =============================================================================
# E-Commerce Microservices - Variables de Entorno (.env.example)
# =============================================================================
# Copie este archivo a '.env' para sobrescribir los valores por defecto locales:
#   cp .env.example .env
# IMPORTANTE: En entornos productivos, utilice contraseñas y claves criptográficas robustas.

# -----------------------------------------------------------------------------
# INFRAESTRUCTURA (PostgreSQL y RabbitMQ)
# -----------------------------------------------------------------------------
DB_USER=admin
DB_PASS=Password123!
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# -----------------------------------------------------------------------------
# SEGURIDAD Y TOKENS JWT
# Clave simétrica compartida entre el Gateway y los microservicios
# (Mínimo 256 bits / 32 caracteres para algoritmo HMAC-SHA256)
# -----------------------------------------------------------------------------
JWT_KEY=ClaveGenericaDeDesarrolloLocalParaFirmarTokens12345!
