# =============================================================================
# E-Commerce Microservices - Variables de Entorno de Ejemplo
# =============================================================================
# Copie este archivo a '.env' para sobrescribir los valores por defecto locales.
# IMPORTANTE: En entornos productivos, utilice contraseñas y claves criptográficas robustas.

# -----------------------------------------------------------------------------
# INFRAESTRUCTURA DOCKER (PostgreSQL, RabbitMQ, Redis)
# -----------------------------------------------------------------------------
DB_USER=admin
DB_PASS=Password123!
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# -----------------------------------------------------------------------------
# AUTENTICACIÓN Y SEGURIDAD JWT (Compartida entre Gateway y Servicios)
# Clave simétrica (mínimo 256 bits / 32 caracteres para HMAC-SHA256)
# -----------------------------------------------------------------------------
Jwt__Key=ClaveGenericaDeDesarrolloLocalParaFirmarTokens12345!
Jwt__Issuer=Api.Auth
Jwt__Audience=ECommerceClients
Jwt__ExpireMinutes=60

# -----------------------------------------------------------------------------
# MESSAGE BROKER (RabbitMQ)
# -----------------------------------------------------------------------------
RabbitMQ__Host=localhost
RabbitMQ__Username=guest
RabbitMQ__Password=guest

# -----------------------------------------------------------------------------
# CACHE & RATE LIMITING (Redis)
# -----------------------------------------------------------------------------
ConnectionStrings__Redis=localhost:6379

# -----------------------------------------------------------------------------
# BASES DE DATOS (PostgreSQL por Microservicio)
# -----------------------------------------------------------------------------
# Api.Auth:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=auth_db;Username=admin;Password=Password123!

# Api.Inventario:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=inventario_db;Username=admin;Password=Password123!

# Api.Pedidos:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pedidos_db;Username=admin;Password=Password123!
