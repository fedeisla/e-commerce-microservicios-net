{
  "info": {
    "_postman_id": "f44c134e-6863-4bfc-a721-f4dfdf8bfe02",
    "name": "E-Commerce Microservicios (.NET 10 / YARP / Saga)",
    "description": "Colección completa de pruebas para el ecosistema de microservicios e-commerce.\nTodas las peticiones apuntan al API Gateway YARP en {{base_url}} (http://localhost:5000).\nEl endpoint de Login guarda automáticamente el JWT en la variable de colección {{bearer_token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación (Api.Auth)",
      "item": [
        {
          "name": "1.1 Registrar Usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Registra un nuevo usuario en auth_db. Publica UsuarioRegistradoEvent en RabbitMQ para que Api.Pedidos cree automáticamente su carrito."
          },
          "response": []
        },
        {
          "name": "1.2 Login (Guarda Token Automáticamente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"bearer_token\", jsonData.token);",
                  "    console.log(\"Token JWT guardado en {{bearer_token}}\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión y genera un JWT con expiración de 60 minutos. El script de pruebas almacena automáticamente el token en la variable {{bearer_token}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Catálogo e Inventario (Api.Inventario)",
      "item": [
        {
          "name": "2.1 Listar Productos (Público / Cacheado en Redis)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Consulta el catálogo público. Utiliza la directiva de OutputCache en YARP respaldada por Redis (CatalogoCache)."
          },
          "response": []
        },
        {
          "name": "2.2 Obtener Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/productos/{{producto_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos",
                "{{producto_id}}"
              ]
            },
            "description": "Obtiene los detalles y el stock disponible de un producto específico."
          },
          "response": []
        },
        {
          "name": "2.3 Crear Producto (Requiere Rol Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var prodId = jsonData.idProducto || jsonData.id;",
                  "if (prodId) {",
                  "    pm.collectionVariables.set(\"producto_id\", prodId);",
                  "    console.log(\"ID de Producto guardado en {{producto_id}}: \" + prodId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"PROD-001\",\n  \"nombre\": \"Teclado Mecánico RGB\",\n  \"precioBase\": 50000,\n  \"stockDisponible\": 15\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Crea un producto en inventario_db. Protegido en YARP por política AdminOnly y en el controlador con [Authorize]. Guarda el ID en {{producto_id}}."
          },
          "response": []
        },
        {
          "name": "2.4 Registrar Movimiento de Stock (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idProducto\": \"{{producto_id}}\",\n  \"cantidad\": 10,\n  \"motivo\": \"Ingreso de nuevo lote de mercadería\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/productos/movimientos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "productos",
                "movimientos"
              ]
            },
            "description": "Incrementa el stock disponible del producto y registra la trazabilidad en la tabla MOVIMIENTO_STOCK."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Carrito y Checkout Saga (Api.Pedidos)",
      "item": [
        {
          "name": "3.1 Consultar Carrito del Usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pedidos/carrito",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pedidos",
                "carrito"
              ]
            },
            "description": "Obtiene los ítems vigentes en el carrito del usuario autenticado (extraído del claim NameIdentifier del JWT)."
          },
          "response": []
        },
        {
          "name": "3.2 Agregar Ítem al Carrito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": \"{{producto_id}}\",\n  \"productoNombre\": \"Teclado Mecánico RGB\",\n  \"precioUnitario\": 50000,\n  \"cantidad\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pedidos/carrito/items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pedidos",
                "carrito",
                "items"
              ]
            },
            "description": "Agrega una línea de producto al carrito del usuario autenticado."
          },
          "response": []
        },
        {
          "name": "3.3 Checkout (Disparar Saga Coreografiada)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.pedidoId) {",
                  "    pm.collectionVariables.set(\"pedido_id\", jsonData.pedidoId);",
                  "    console.log(\"Pedido ID guardado en {{pedido_id}}: \" + jsonData.pedidoId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pedidos/carrito/checkout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pedidos",
                "carrito",
                "checkout"
              ]
            },
            "description": "Inicia la Saga Coreografiada:\n1. Crea el pedido en estado 'Pendiente'.\n2. Publica 'PedidoCreadoEvent' a RabbitMQ.\n3. Protegido por Rate Limiting (Fixed Window) contra ráfagas de spam.\n4. Guarda el 'pedidoId' resultante en {{pedido_id}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Gestión Directa de Pedidos (PedidosController)",
      "item": [
        {
          "name": "4.1 Crear Pedido Directo (POST /api/pedidos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var pId = jsonData.id || jsonData.pedidoId;",
                  "if (pId) {",
                  "    pm.collectionVariables.set(\"pedido_id\", pId);",
                  "    console.log(\"Pedido creado directamente guardado en {{pedido_id}}: \" + pId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{cliente_id}}\",\n  \"detalles\": [\n    {\n      \"productoId\": \"{{producto_id}}\",\n      \"cantidad\": 2,\n      \"precioUnitario\": 50000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/pedidos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "Endpoint directo en PedidosController (protegido con [Authorize]).\nCrea un pedido con sus detalles y emite el evento 'PedidoCreadoEvent' en RabbitMQ para disparar la validación asíncrona de inventario en la Saga."
          },
          "response": []
        },
        {
          "name": "4.2 Consultar Pedido por ID (GET /api/pedidos/{id})",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/pedidos/{{pedido_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "pedidos",
                "{{pedido_id}}"
              ]
            },
            "description": "Consulta el estado actual de la orden (Pendiente, Confirmado o Rechazado tras la resolución asíncrona de la Saga)."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "bearer_token",
      "value": ""
    },
    {
      "key": "producto_id",
      "value": "83ea1c2a-9bc5-420a-8bf4-99881775e52c"
    },
    {
      "key": "cliente_id",
      "value": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
    },
    {
      "key": "pedido_id",
      "value": "ec1bbd99-97eb-45a6-85f1-302ec62c62b1"
    }
  ]
}